# 복사해서 .env 로 저장하면 자동으로 읽습니다. 값을 비우면 기본값이 쓰입니다.

# DB: 기본은 backend/data/app.db (SQLite). PostgreSQL 전환 시 URL 만 바꿉니다.
# DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://mrworld:mrworld@localhost:5432/mrworld

# JWT 서명 키 (운영에서는 반드시 변경)
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 프론트 개발 서버 출처 (쉼표 구분)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 업로드 이미지 저장 폴더 (/media 로 서빙)
# MEDIA_DIR=./media

# 문자 알림: console (DB 기록 + 콘솔 로그) | solapi (아래 설정 필요)
SMS_PROVIDER=console

# AI 컨시어지: rules(기본, 키워드 사전) | openai | anthropic
AI_PROVIDER=rules
AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# 문자 실발송 (CoolSMS/Solapi). 세 값이 모두 있으면 SMS_PROVIDER=solapi 로 실제 발송, 아니면 console(기록만)
# https://console.solapi.com 에서 API Key/Secret 발급, 발신번호 등록 후 아래에 입력
# SMS_PROVIDER=solapi
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SMS_FROM=01012345678

